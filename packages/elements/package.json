{
  "name": "@gausszhou/litegui-elements",
  "version": "1.0.1",
  "description": "Web Components adapter for LiteGUI: framework-free custom elements backed by Shadow DOM",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./define": "./src/define.ts",
    "./area": "./src/elements/area.ts",
    "./box": "./src/elements/box.ts",
    "./button": "./src/elements/button.ts",
    "./checkbox": "./src/elements/checkbox.ts",
    "./complex-list": "./src/elements/complex-list.ts",
    "./console": "./src/elements/console.ts",
    "./context-menu": "./src/elements/context-menu.ts",
    "./dialog": "./src/elements/dialog.ts",
    "./dragger": "./src/elements/dragger.ts",
    "./header-bar": "./src/elements/header-bar.ts",
    "./image-editor": "./src/elements/image-editor.ts",
    "./inspector": "./src/elements/inspector.ts",
    "./line-editor": "./src/elements/line-editor.ts",
    "./list": "./src/elements/list.ts",
    "./menu": "./src/elements/menu.ts",
    "./node-editor": "./src/elements/node-editor.ts",
    "./panel": "./src/elements/panel.ts",
    "./searchbox": "./src/elements/searchbox.ts",
    "./slider": "./src/elements/slider.ts",
    "./split": "./src/elements/split.ts",
    "./status-bar": "./src/elements/status-bar.ts",
    "./table": "./src/elements/table.ts",
    "./tabs": "./src/elements/tabs.ts",
    "./text-editor": "./src/elements/text-editor.ts",
    "./timeline": "./src/elements/timeline.ts",
    "./toolbar": "./src/elements/toolbar.ts",
    "./tree": "./src/elements/tree.ts",
    "./viewport": "./src/elements/viewport.ts",
    "./tokens.css": "./src/styles/generated/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./src/index.ts",
    "./src/umd.ts",
    "./dist/index.js",
    "./dist/index.umd.cjs"
  ],
  "scripts": {
    "styles": "node ../../scripts/build-elements-css.mjs",
    "dev": "pnpm styles && vite",
    "build": "pnpm styles && vite build && vite build --config vite.cjs.config.ts && vite build --config vite.umd.config.ts && tsc -p tsconfig.json --emitDeclarationOnly --declaration && node ../../scripts/copy-file.mjs src/styles/generated/tokens.css dist/tokens.css",
    "typecheck": "pnpm styles && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gausszhou/litegui-components": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./define": {
        "types": "./dist/types/define.d.ts",
        "import": "./dist/define.js"
      },
      "./area": {
        "types": "./dist/types/elements/area.d.ts",
        "import": "./dist/elements/area.js"
      },
      "./box": {
        "types": "./dist/types/elements/box.d.ts",
        "import": "./dist/elements/box.js"
      },
      "./button": {
        "types": "./dist/types/elements/button.d.ts",
        "import": "./dist/elements/button.js"
      },
      "./checkbox": {
        "types": "./dist/types/elements/checkbox.d.ts",
        "import": "./dist/elements/checkbox.js"
      },
      "./complex-list": {
        "types": "./dist/types/elements/complex-list.d.ts",
        "import": "./dist/elements/complex-list.js"
      },
      "./console": {
        "types": "./dist/types/elements/console.d.ts",
        "import": "./dist/elements/console.js"
      },
      "./context-menu": {
