        "import": "./dist/elements/context-menu.js"
      },
      "./dialog": {
        "types": "./dist/types/elements/dialog.d.ts",
        "import": "./dist/elements/dialog.js"
      },
      "./dragger": {
        "types": "./dist/types/elements/dragger.d.ts",
        "import": "./dist/elements/dragger.js"
      },
      "./header-bar": {
        "types": "./dist/types/elements/header-bar.d.ts",
        "import": "./dist/elements/header-bar.js"
      },
      "./image-editor": {
        "types": "./dist/types/elements/image-editor.d.ts",
        "import": "./dist/elements/image-editor.js"
      },
      "./inspector": {
        "types": "./dist/types/elements/inspector.d.ts",
        "import": "./dist/elements/inspector.js"
      },
      "./line-editor": {
        "types": "./dist/types/elements/line-editor.d.ts",
        "import": "./dist/elements/line-editor.js"
      },
      "./list": {
        "types": "./dist/types/elements/list.d.ts",
        "import": "./dist/elements/list.js"
      },
      "./menu": {
        "types": "./dist/types/elements/menu.d.ts",
        "import": "./dist/elements/menu.js"
      },
      "./node-editor": {
        "types": "./dist/types/elements/node-editor.d.ts",
        "import": "./dist/elements/node-editor.js"
      },
      "./panel": {
        "types": "./dist/types/elements/panel.d.ts",
        "import": "./dist/elements/panel.js"
      },
      "./searchbox": {
        "types": "./dist/types/elements/searchbox.d.ts",
        "import": "./dist/elements/searchbox.js"
      },
      "./slider": {
        "types": "./dist/types/elements/slider.d.ts",
        "import": "./dist/elements/slider.js"
      },
      "./split": {
        "types": "./dist/types/elements/split.d.ts",
        "import": "./dist/elements/split.js"
      },
      "./status-bar": {
        "types": "./dist/types/elements/status-bar.d.ts",
        "import": "./dist/elements/status-bar.js"
      },
      "./table": {
        "types": "./dist/types/elements/table.d.ts",
        "import": "./dist/elements/table.js"
      },
      "./tabs": {
        "types": "./dist/types/elements/tabs.d.ts",
        "import": "./dist/elements/tabs.js"
      },
      "./text-editor": {
        "types": "./dist/types/elements/text-editor.d.ts",
        "import": "./dist/elements/text-editor.js"
      },
      "./timeline": {
        "types": "./dist/types/elements/timeline.d.ts",
        "import": "./dist/elements/timeline.js"
      },
      "./toolbar": {
        "types": "./dist/types/elements/toolbar.d.ts",
        "import": "./dist/elements/toolbar.js"
      },
      "./tree": {
        "types": "./dist/types/elements/tree.d.ts",
        "import": "./dist/elements/tree.js"
      },
      "./viewport": {
        "types": "./dist/types/elements/viewport.d.ts",
