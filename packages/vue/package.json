{
  "name": "@gausszhou/litegui-vue",
  "version": "1.0.1",
  "description": "Vue 3 bindings for LiteGUI components",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/components/button.ts",
    "./checkbox": "./src/components/checkbox.ts",
    "./slider": "./src/components/slider.ts",
    "./panel": "./src/components/panel.ts",
    "./dialog": "./src/components/dialog.ts",
    "./menu": "./src/components/menu.ts",
    "./package.json": "./package.json",
    "./list": "./src/components/list.ts",
    "./searchbox": "./src/components/searchbox.ts",
    "./split": "./src/components/split.ts",
    "./table": "./src/components/table.ts",
    "./tabs": "./src/components/tabs.ts",
    "./dragger": "./src/components/dragger.ts",
    "./console": "./src/components/console.ts",
    "./area": "./src/components/area.ts",
    "./box": "./src/components/box.ts",
    "./complex-list": "./src/components/complex-list.ts",
    "./context-menu": "./src/components/context-menu.ts",
    "./header-bar": "./src/components/header-bar.ts",
    "./image-editor": "./src/components/image-editor.ts",
    "./inspector": "./src/components/inspector.ts",
    "./line-editor": "./src/components/line-editor.ts",
    "./node-editor": "./src/components/node-editor.ts",
    "./status-bar": "./src/components/status-bar.ts",
    "./text-editor": "./src/components/text-editor.ts",
    "./timeline": "./src/components/timeline.ts",
    "./toolbar": "./src/components/toolbar.ts",
    "./tree": "./src/components/tree.ts",
    "./viewport": "./src/components/viewport.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.cjs.config.ts && tsc -p tsconfig.json --emitDeclarationOnly --declaration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gausszhou/litegui-components": "workspace:*",
    "@gausszhou/litegui-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^5.4.11",
    "vue": "^3.5.46"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./button": {
        "types": "./dist/types/components/button.d.ts",
        "import": "./dist/components/button.js"
      },
      "./checkbox": {
        "types": "./dist/types/components/checkbox.d.ts",
        "import": "./dist/components/checkbox.js"
      },
      "./slider": {
        "types": "./dist/types/components/slider.d.ts",
        "import": "./dist/components/slider.js"
      },
      "./panel": {
        "types": "./dist/types/components/panel.d.ts",
        "import": "./dist/components/panel.js"
      },
      "./dialog": {
        "types": "./dist/types/components/dialog.d.ts",
        "import": "./dist/components/dialog.js"
      },
      "./menu": {
        "types": "./dist/types/components/menu.d.ts",
        "import": "./dist/components/menu.js"
      },
      "./package.json": "./package.json",
      "./list": {
        "types": "./dist/types/components/list.d.ts",
        "import": "./dist/components/list.js"
      },
      "./searchbox": {
        "types": "./dist/types/components/searchbox.d.ts",
        "import": "./dist/components/searchbox.js"
      },
      "./split": {
        "types": "./dist/types/components/split.d.ts",
        "import": "./dist/components/split.js"
      },
      "./table": {
        "types": "./dist/types/components/table.d.ts",
        "import": "./dist/components/table.js"
      },
      "./tabs": {
        "types": "./dist/types/components/tabs.d.ts",
        "import": "./dist/components/tabs.js"
      },
      "./dragger": {
        "types": "./dist/types/components/dragger.d.ts",
        "import": "./dist/components/dragger.js"
      },
      "./console": {
        "types": "./dist/types/components/console.d.ts",
        "import": "./dist/components/console.js"
      },
      "./area": {
        "types": "./dist/types/components/area.d.ts",
        "import": "./dist/components/area.js"
      },
      "./box": {
        "types": "./dist/types/components/box.d.ts",
        "import": "./dist/components/box.js"
      },
      "./complex-list": {
        "types": "./dist/types/components/complex-list.d.ts",
        "import": "./dist/components/complex-list.js"
      },
      "./context-menu": {
        "types": "./dist/types/components/context-menu.d.ts",
        "import": "./dist/components/context-menu.js"
      },
      "./header-bar": {
        "types": "./dist/types/components/header-bar.d.ts",
        "import": "./dist/components/header-bar.js"
      },
      "./image-editor": {
        "types": "./dist/types/components/image-editor.d.ts",
        "import": "./dist/components/image-editor.js"
      },
      "./inspector": {
        "types": "./dist/types/components/inspector.d.ts",
        "import": "./dist/components/inspector.js"
      },
      "./line-editor": {
        "types": "./dist/types/components/line-editor.d.ts",
        "import": "./dist/components/line-editor.js"
      },
      "./node-editor": {
        "types": "./dist/types/components/node-editor.d.ts",
        "import": "./dist/components/node-editor.js"
      },
      "./status-bar": {
        "types": "./dist/types/components/status-bar.d.ts",
        "import": "./dist/components/status-bar.js"
      },
      "./text-editor": {
        "types": "./dist/types/components/text-editor.d.ts",
        "import": "./dist/components/text-editor.js"
      },
      "./timeline": {
        "types": "./dist/types/components/timeline.d.ts",
        "import": "./dist/components/timeline.js"
      },
      "./toolbar": {
        "types": "./dist/types/components/toolbar.d.ts",
        "import": "./dist/components/toolbar.js"
      },
      "./tree": {
        "types": "./dist/types/components/tree.d.ts",
        "import": "./dist/components/tree.js"
      },
      "./viewport": {
        "types": "./dist/types/components/viewport.d.ts",
        "import": "./dist/components/viewport.js"
      }
    }
  },
