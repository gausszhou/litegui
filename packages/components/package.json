        "import": "./dist/entries/dragger.js"
      },
      "./line-editor": {
        "types": "./dist/types/entries/line-editor.d.ts",
        "import": "./dist/entries/line-editor.js"
      },
      "./header-bar": {
        "types": "./dist/types/entries/header-bar.d.ts",
        "import": "./dist/entries/header-bar.js"
      },
      "./status-bar": {
        "types": "./dist/types/entries/status-bar.d.ts",
