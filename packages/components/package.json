{
  "name": "@gausszhou/litegui-components",
  "version": "1.0.1",
  "description": "Framework-free desktop-style Web UI components built on native DOM + TypeScript",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/styles/index.scss",
    "./package.json": "./package.json",
    "./area": "./src/entries/area.ts",
    "./panel": "./src/entries/panel.ts",
    "./split": "./src/entries/split.ts",
    "./tabs": "./src/entries/tabs.ts",
    "./dialog": "./src/entries/dialog.ts",
    "./menu": "./src/entries/menu.ts",
    "./button": "./src/entries/button.ts",
    "./checkbox": "./src/entries/checkbox.ts",
    "./slider": "./src/entries/slider.ts",
    "./searchbox": "./src/entries/searchbox.ts",
    "./list": "./src/entries/list.ts",
    "./table": "./src/entries/table.ts",
    "./console": "./src/entries/console.ts",
    "./inspector": "./src/entries/inspector.ts",
    "./tree": "./src/entries/tree.ts",
    "./box": "./src/entries/box.ts",
    "./complex-list": "./src/entries/complex-list.ts",
    "./context-menu": "./src/entries/context-menu.ts",
    "./dragger": "./src/entries/dragger.ts",
    "./line-editor": "./src/entries/line-editor.ts",
    "./header-bar": "./src/entries/header-bar.ts",
    "./status-bar": "./src/entries/status-bar.ts",
    "./timeline": "./src/entries/timeline.ts",
    "./toolbar": "./src/entries/toolbar.ts",
    "./node-editor": "./src/entries/node-editor.ts",
    "./text-editor": "./src/entries/text-editor.ts",
    "./image-editor": "./src/entries/image-editor.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.cjs.config.ts && vite build --config vite.umd.config.ts && sass src/styles/index.scss dist/style.css --no-source-map && tsc -p tsconfig.json --emitDeclarationOnly --declaration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gausszhou/litegui-core": "workspace:*",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "sass": "^1.83.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json",
      "./area": {
        "types": "./dist/types/entries/area.d.ts",
        "import": "./dist/entries/area.js"
      },
      "./panel": {
