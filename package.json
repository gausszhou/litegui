{
  "name": "litegui-monorepo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "LiteGUI monorepo: framework-free desktop-style Web UI library",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @gausszhou/litegui-vscode dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{ts,scss}\" \"apps/**/*.{ts,js,css,html}\"",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @gausszhou/litegui-tests test:watch",
    "test:coverage": "pnpm --filter @gausszhou/litegui-tests coverage",
    "test:e2e": "pnpm --filter @gausszhou/litegui-tests e2e",
    "bench": "pnpm --filter @gausszhou/litegui-tests bench",
    "size": "node scripts/size-report.mjs",
    "verify-pack": "node scripts/verify-pack.mjs",
    "verify-umd": "node scripts/verify-umd.mjs",
    "docs:dev": "pnpm elements:styles && pnpm docs:styles && pnpm docs:api && vitepress dev docs --host 127.0.0.1 --port 5178",
    "docs:build": "pnpm elements:styles && pnpm docs:styles && pnpm docs:api && vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "docs:api": "typedoc",
    "pages:build": "node scripts/build-pages.mjs",
    "remove": "rm -rf packages/*/dist packages/*/node_modules apps/*/node_modules apps/*/dist",
    "docs:styles": "node scripts/build-demo-css.mjs",
    "elements:styles": "node scripts/build-elements-css.mjs",
    "dev:blender": "pnpm --filter @gausszhou/litegui-blender dev",
    "dev:vectorcraft": "pnpm --filter @gausszhou/litegui-vectorcraft dev",
    "dev:lightcraft": "pnpm --filter @gausszhou/litegui-lightcraft dev",
    "dev:gridcraft": "pnpm --filter @gausszhou/litegui-gridcraft dev",
    "dev:photocraft": "pnpm --filter @gausszhou/litegui-photocraft dev",
    "dev:pdfcraft": "pnpm --filter @gausszhou/litegui-pdfcraft dev",
    "dev:filmcraft": "pnpm --filter @gausszhou/litegui-filmcraft dev",
    "dev:cadcraft": "pnpm --filter @gausszhou/litegui-cadcraft dev",
    "dev:vscode": "pnpm --filter @gausszhou/litegui-vscode dev",
    "dev:wordcraft": "pnpm --filter @gausszhou/litegui-wordcraft dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gausszhou/litegui-components": "workspace:*",
    "@gausszhou/litegui-core": "workspace:*",
    "@gausszhou/litegui-elements": "workspace:*",
    "@gausszhou/litegui-vue": "workspace:*",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.2.1",
    "prettier": "^2.8.8",
    "sass": "^1.108.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vitepress": "^1.6.3"
  }
}
